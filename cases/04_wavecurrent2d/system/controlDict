FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     waveFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// 80 s = 20 s ramp (Tsoft) + ~13 s for the first crest to traverse 200 m at
// c~15 m/s + ~4-5 periods of established propagation/absorption.
endTime         300;    // steady window 150-300 s (15 periods) after ~123 s tank fill + ramp

deltaT          0.01;

writeControl    adjustableRunTime;

writeInterval   2;      // field snapshots for animation only; probes have their own 0.2 s cadence

purgeWrite      2;      // keep the last two field writes; gauges+probes carry the result

writeFormat     binary;

writePrecision  8;

writeCompression on;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

adjustTimeStep  yes;

maxCo           0.25;   // CrankNicolson 0.9 needs Co<~0.25 for neutral wave propagation

maxAlphaCo      0.25;

maxDeltaT       0.05;

functions
{
    #include "surfaceElevation"
    #include "uProbes"
}

// ************************************************************************* //

