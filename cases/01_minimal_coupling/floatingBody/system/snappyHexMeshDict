FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    float.stl
    {
        type triSurfaceMesh;
        name float;
    }

};

castellatedMeshControls
{
    maxLocalCells       600000;
    maxGlobalCells      6000000;    
    minRefinementCells  0;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;         


    features
    (
        {
            file "float.eMesh";
            level 2;
        }
    );

    refinementSurfaces
    {
        float
        {
            level (1 2);
            patchInfo { type wall; }
        }
    }

    resolveFeatureAngle 60;   // v6 value; 30 over-marks gentle curvature

    refinementRegions
    {

        float { mode distance; levels ((2.0 2) (6.0 1)); }
    }

    locationInMesh      (0.13 0.17 15.2);

    allowFreeStandingZoneFaces true;
}

snapControls
{
   
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          30;
    nRelaxIter          5;


    nFeatureSnapIter    15;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;
    expansionRatio      1.0;
    finalLayerThickness 0.3;
    minThickness        0.1;
    layers              {}
    nGrow               0;
    featureAngle        130;
    maxFaceThicknessRatio 0.5;
    nSmoothSurfaceNormals 1;
    nSmoothThickness    10;
    minMedialAxisAngle  90;
    maxThicknessToMedialRatio 0.3;
    nSmoothNormals      3;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
    nRelaxedIter        20;
}

meshQualityControls
{
    #include "meshQualityDict"
    relaxed { maxNonOrtho 75; }
    nSmoothScale    4;
    errorReduction  0.75;
}

writeFlags
(
    scalarLevels
);

mergeTolerance 1e-6;

