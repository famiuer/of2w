FoamFile
{
    version	2.0;
    format	ascii;
    class	dictionary;
    object	waveProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

seaLevel            0;

relaxationNames     ( inlet outlet );

initializationName  outlet;

inletCoeffs
{
    waveType            stokesSecond;
    Tsoft               20;
    depth               80;
    period              10;
    direction           ( 1 0 0 );
    phi                 1.773253;
    height              6;
    waveNumber          (0.040369292 0 0);
    omega               0.62831853;
    debug               0;

    relaxationZone
    {
        relaxationScheme    Spatial;
        relaxationShape     Rectangular;
        beachType           Empty;
        relaxType           INLET;
        startX              ( -400 -100 -80 );
        endX                ( -250 100 35 );
        orientation         ( 1 0 0 );
        exponent            2;
        courantCorrection   yes;
    }
}

outletCoeffs
{
    waveType            potentialCurrent;
    U                   ( 0 0 0 );
    Tsoft               20;

    relaxationZone
    {
        relaxationScheme    Spatial;
        relaxationShape     Rectangular;
        beachType           Empty;
        relaxType           OUTLET;
        startX              ( 200 -100 -80 );
        endX                ( 561 100 35 );
        orientation         ( 1 0 0 );
        exponent            2;
        courantCorrection   yes;
    }
}



