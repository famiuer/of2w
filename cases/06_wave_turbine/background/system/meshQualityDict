FoamFile
{
    format      ascii;
    class       dictionary;
    object      meshQualityDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

maxNonOrtho 75;
maxBoundarySkewness 20;	//Original 20 for better quality 4
maxInternalSkewness 4;

/*
maxNonOrtho 180;
maxBoundarySkewness -1;	
maxInternalSkewness -1;
*/

maxConcave 80;

minVol 1e-13;

// v6 quality fix: was -1e+30 (check disabled), which let snappy keep faces
// with negative-volume tet decompositions (checkMesh "lowQualityTetFaces").
// A morphing mesh interpolates point motion through the face tet
// decomposition, so these must be rejected during snapping.
minTetQuality 1e-15;

minArea -1;

minTwist 0.02;

minDeterminant 0.001;

minFaceWeight 0.05;

minVolRatio 0.01;

minTriangleTwist -1;


// ************************************************************************* //
