    (
        // x: [ -400,260 ] 550 @ 1.2 m | [260,561] 100 graded x4 (1.39->5.6 m)
        (
            (660 550 1)
            (301 100 4)
        )
        // y: 30 m graded 6.8->1.7 m | 100 m @ 2.5 m | mirrored
