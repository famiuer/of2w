#!/bin/bash
# slurm.example — template batch script for 06_wave_turbine (adapt the
# SBATCH lines and the environment block to YOUR cluster, then submit
# with: sbatch slurm.example). Production reference used 64 ranks.
#SBATCH -J of2w_wave_turbine
#SBATCH -N 1
#SBATCH -n 64
#SBATCH --mem=96G
#SBATCH -t 48:00:00
#SBATCH -o slurm-%x-%j.out

# ---- environment: OpenFOAM v2306 + waves2Foam + the OF2W libraries -------
# On module-based clusters load the module FIRST; env.sh then finds the
# bashrc, sets the OF2W vars and sources waves2Foam (and reports anything
# missing):
# module load openfoam/v2306        # uncomment/adapt on module-based clusters
source "$SLURM_SUBMIT_DIR/../../env.sh"

set -o pipefail
cd "$SLURM_SUBMIT_DIR"
NP=${SLURM_NTASKS:-64} ./run.sh
