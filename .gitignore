# Build trees
build/
*.o
*.a
*.so
*.dylib
**/lnInclude/
**/Make/linux64*
**/Make/**/*.dep
**/Make/**/sourceFiles
**/Make/**/variables

# STL is shipped as .gz; the inflated .stl is generated by the mesh script
**/triSurface/*.stl

# OpenFOAM run artefacts (never check these in — they're case-specific)
**/processor*/
**/postProcessing/
**/log.*
**/0/
**/VTK/
**/*.foam
**/case.FOAM
**/mesh.FOAM

# OpenFAST run artefacts (outputs only — .fst and .dat are INPUTS, keep them)
**/openfast/*.out
**/openfast/*.outb
**/openfast/*.sum
**/openfast/*.ED.sum
**/openfast/*.HD.sum
**/openfast/*.MD.out
**/openfast/*.SEA.sum
**/openfast/log.openfast

# Mooring run artefacts
**/Mooring/*.out
**/Mooring/*_*.out
**/Mooring/VTK/

# Backup / scratch
*.bak
*.tmp
*~
.DS_Store
*.swp
__pycache__/
*.pyc

# Editor
.idea/
.vscode/

# SLURM
slurm-*.out
*.slurm.log

# OMC tool state
.omc/

# Compiled test binaries (built by test/run_tests.sh)
coupling/restraints/openfoam/of2/test/aitken_test
coupling/restraints/openfoam/of2/test/frameAlgebra_test
coupling/restraints/openfoam/of2/test/harness/testRestrainHarness
*.dep
**/constant/polyMesh/
**/Mooring/VTK/
**/Mooring/*.out
