#!/usr/bin/env bash
#SBATCH -J of2w_coupled
#SBATCH -p shared
#SBATCH -t 72:00:00
#SBATCH -N 1
#SBATCH -n 64
#SBATCH --mem=96G
#SBATCH -o slurm-%x-%j.out
# =========================================================================
# Restart-aware coupled B-leg (restart plan phase 4). Replaces the
# "no coupled restart" guard of the original two-leg scripts: a run that
# died on wall time simply resubmits this script and continues from the
# newest COMPLETE checkpoint set. Requires the phase 1-3 libraries
# (libOF2 with of2RigidBodyStateWriter + of2RestraintState/FAST checkpoint,
# librigidBodyMooring with moorDynState) and the case's controlDict
# functions entry:
#     rigidBodyState { type of2RigidBodyStateWriter; libs ("libOF2.so");
#                      writeControl writeTime; }
#
# A restart point at time t is COMPLETE iff processor0/<t>/ has:
#   fields (U, ...) + uniform/rigidBodyMotionState (body q/qDot/qDdot)
#   + uniform/of2RestraintState  (coupling scalars + FAST checkpoint name)
#   + uniform/moorDynState       (MoorDyn line states)
#   + the named openfast/chkpt_<t>.chkp file
# Anything newer than the newest complete set is a partial write -> trimmed.
#
# Restart MUST reuse the same decomposition (-n) as the original run.
# =========================================================================
source /nobackup/nnrq22/coupling/scripts/env.sh
set -o pipefail
d=$OF2_ROOT/cases/CASE_NAME_HERE/background      # <-- case dir
REL=80                                           # <-- release time
cd "$d" || exit 1
export FOAM_SIGFPE=false

endTime=$(foamDictionary -entry endTime -value system/controlDict)

times() { ls processor0 | grep -E '^[0-9]+(\.[0-9]+)?$' | sort -g; }

complete() {   # is time dir $1 a complete restart point?
    local t=$1 u=processor0/$1/uniform
    ls processor0/$t/U* > /dev/null 2>&1            || return 1
    [ -f $u/rigidBodyMotionState ]                  || return 1
    [ -f $u/of2RestraintState ]                     || return 1
    [ -f $u/moorDynState ]                          || return 1
    local root
    root=$(sed -n 's/^ *fastCheckpointRoot *"\{0,1\}\([^";]*\).*/\1/p' \
           $u/of2RestraintState | head -1)
    [ -n "$root" ] && [ -f "$root.chkp" ]           || return 1
    return 0
}

# ---- find the newest complete restart point (>= REL) ---------------------
start=""
for t in $(times | tac); do
    awk -v t="$t" -v r="$REL" 'BEGIN{exit !(t>=r-0.001)}' || break
    if complete "$t"; then start=$t; break; fi
done

if [ -n "$start" ] && awk -v s="$start" -v e="$endTime" \
    'BEGIN{exit !(s>=e-0.001)}'; then
    echo "endTime $endTime already reached (latest complete: $start) - done."
    exit 0
fi

# ---- trim partial time dirs beyond the restart point ---------------------
trim_beyond() {
    local lim=$1
    for p in processor*; do
        for td in $(ls $p | grep -E '^[0-9]+(\.[0-9]+)?$'); do
            awk -v t="$td" -v l="$lim" 'BEGIN{exit !(t>l+0.001)}' \
                && rm -rf $p/$td
        done
    done
}

if [ -n "$start" ]; then
    echo "[$(date -Is)] RESTART from complete checkpoint t=$start"
    trim_beyond "$start"
    # archive MoorDyn outputs: the restarted instance TRUNCATES lines_oc4.out
    # (and restamps rows from an internal clock that restarts at 0 -- shift
    # by the leg start time in post-processing). OpenFAST output APPENDS
    # across restarts and needs no archival.
    # NEVER clobber an existing archive: when a leg fails at the same start
    # time, the next leg would re-archive the FAILED leg's near-empty output
    # over the previous (good) archive -- this destroyed the leg-1 mooring
    # series of all three _long chains on 2026-08-08/10. Fall back to a
    # job-id-suffixed name so nothing is ever overwritten.
    for f in Mooring/*.out; do
        [ -f "$f" ] || continue
        if [ -e "$f.t$start" ]; then
            mv "$f" "$f.t$start.j$SLURM_JOB_ID"
        else
            mv "$f" "$f.t$start"
        fi
    done
else
    # fresh coupled start: original two-leg semantics (cold OpenFAST +
    # MoorDyn IC solve at the held pose). Guards from the original scripts.
    #
    # REFUSAL GATE: falling through to here on a RELAY means the restart-point
    # audit failed (pruned/corrupt chkpt, filesystem glitch, wrong REL). The
    # trim below would then DELETE every computed time dir past t=REL. Only a
    # genuine first leg (not chained, no data beyond REL) may fresh-start
    # unprompted; anything else must be forced explicitly.
    newest=$(times | tail -1)
    if [ "${OF2_CHAINED:-0}" = 1 ] || \
       awk -v n="${newest:-0}" -v r="$REL" 'BEGIN{exit !(n>r+0.001)}'; then
        if [ -z "$OF2_ALLOW_FRESH" ]; then
            echo "ERR: no complete restart point, but computed data exists" \
                 "past t=$REL (newest=$newest chained=${OF2_CHAINED:-0})."
            echo "     Refusing to fresh-start: that would DELETE every time" \
                 "dir beyond t=$REL. Investigate the checkpoint set, or"
            echo "     force with OF2_ALLOW_FRESH=1. Not chaining."
            exit 1
        fi
        echo "WARN: OF2_ALLOW_FRESH=1 set - fresh start will trim past t=$REL"
    fi
    echo "[$(date -Is)] FRESH coupled start at release t=$REL"
    grep -m1 -q "rigidBodyMotion" constant/dynamicMeshDict.coupled || {
        echo "ERR: dynamicMeshDict.coupled is not the coupled RBD dict"; exit 1; }
    N=$(grep -cE 'type +(OpenFast|moorDynR2)' constant/dynamicMeshDict.coupled)
    [ "$N" -ge 2 ] || { echo "ERR: coupled dict lacks OpenFast/moorDynR2"; exit 1; }
    [ -d processor0/$REL ] || { echo "ERR: release snapshot t=$REL missing"; exit 1; }
    trim_beyond "$REL"
    for p in processor*; do
        [ -f $p/$REL/pointDisplacement ] || cp $p/0/pointDisplacement $p/$REL/
    done
fi

cp constant/dynamicMeshDict.coupled constant/dynamicMeshDict

# ---- chain guard: stop a runaway chain of non-advancing legs -------------
# afterany fires even when a leg FAILS, so without this a single restart
# failure resubmits forever (1,489 jobs on 2026-08-08). Track the restart
# point across auto-chained legs; after 2 consecutive legs with no advance,
# refuse to run or chain. A manual submission (no OF2_CHAINED in the env)
# resets the counter, so resubmitting after a fix just works.
point=${start:-$REL}
STAMP=.relay_progress                      # "<restart point> <strikes>"
strikes=0
if [ "${OF2_CHAINED:-0}" = 1 ] && [ -f "$STAMP" ]; then
    read -r prev prevStrikes < "$STAMP" || true
    if awk -v s="$point" -v p="${prev:--1}" 'BEGIN{exit !(s<=p+0.001)}'; then
        strikes=$(( ${prevStrikes:-0} + 1 ))
    fi
fi
echo "$point $strikes" > "$STAMP"
if [ "$strikes" -ge 2 ]; then
    echo "[$(date -Is)] ERR: restart point stuck at t=$point for $strikes" \
         "consecutive chained legs - stopping the relay chain." \
         "Fix the failure, then resubmit manually (resets the guard)."
    exit 1
fi

# ---- self-chain through wall limits (afterany: fires even on TIMEOUT) ----
if [ "${AUTO_CHAIN:-1}" = 1 ] && [ -z "$OF2_NO_CHAIN" ]; then
    next=$(sbatch --parsable --dependency=afterany:$SLURM_JOB_ID \
           --export=ALL,OF2_CHAINED=1 "$0")
    echo "chained follow-up job $next (exits immediately once endTime reached)"
fi

# ---- run; per-job log so restarts never clobber history ------------------
# Series extraction across restarts: cat log.solver.* in job-id order (or
# rely on "Time =" monotonicity after the trim above).
mpirun -np $SLURM_NPROCS overWaveDyMFoam -parallel 2>&1 \
    | tee log.solver.$SLURM_JOB_ID
RC=${PIPESTATUS[0]}
echo "[$(date -Is)] EXIT=$RC last: $(grep -oE '^Time = [0-9.]+' \
    log.solver.$SLURM_JOB_ID | tail -1)"
exit $RC
